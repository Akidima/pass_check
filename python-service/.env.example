# Passport verification service — environment configuration.
# Copy to .env (or export via systemd//etc/environment) and fill in real values.
# Never commit the real .env; it is already covered by .gitignore.

# ---------------------------------------------------------------------------
# REQUIRED — authentication between the PHP portal and this service
# ---------------------------------------------------------------------------
# High-value service credential. Never commit a real value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# PHP must send the same value as:  Authorization: Bearer <secret>
# The service refuses to start in production if this is missing or shorter
# than 32 characters. Authenticated endpoints return 401 without it.
PORTAL_SHARED_SECRET=
# Optional second secret accepted during a coordinated rotation window.
# Remove it after every PHP worker has been reloaded with the new value.
# PORTAL_SHARED_SECRET_PREVIOUS=
# Local development only. BOTH must be set to start without a valid secret;
# authenticated endpoints still return 401. Never set these in production.
# APP_ENV=development
# ALLOW_INSECURE_AUTH_START=1

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION — model weight caches
# ---------------------------------------------------------------------------
# Both libraries download weights from the internet on first use if these
# directories are empty. Pre-populate them during deployment so no student
# upload ever triggers a network download.
#
#   torchvision Faster R-CNN -> $TORCH_HOME/hub/checkpoints/
#   rembg (default u2netp)   -> $U2NET_HOME/u2netp.onnx
TORCH_HOME=/var/lib/passport-verification/torch
U2NET_HOME=/var/lib/passport-verification/u2net

# Background cutout for /edit-photo. u2netp is the portable U2-Net (~5 MB) and
# is the default because full u2net (~176 MB) was taking 12–21 s per photo on
# CPU — longer than verification. Restore u2net only if measured cutout quality
# on real submissions requires it.
REMBG_MODEL=u2netp
# Longest side fed to rembg. Phone originals are downscaled to this, the mask
# is scaled back. Passport output does not need a 3000px segmentation pass.
EDIT_INFERENCE_MAX_SIDE=768

# ---------------------------------------------------------------------------
# Tie detection
# ---------------------------------------------------------------------------
# Set explicitly in production. 'auto' silently switches to the generic COCO
# detector if the custom checkpoint is missing, which changes decisions.
# Use 'custom' only after deploying a checkpoint AND its calibrated policy.
TIE_DETECTOR_BACKEND=coco
TIE_COCO_THRESHOLD=0.50

# Detector input-resolution budget (COCO backend only).
#
# The upper-body ROI is wide and shallow — measured 174x62 to ~490x250 on real
# submissions — so torchvision's 800/1333 default UPSCALES it 2-8x and spends
# most of the inference budget on interpolated pixels. The shipped 32/1024
# budget avoids upscaling small ROIs and caps large ones. It is intended to
# keep warm tie inference in the 2-5 second operating band, but this must be
# verified on the deployment host and against local images.
#
# Re-measure with benchmarks/verify_tie_resolution_equivalence.py before
# changing these. Smaller budgets can change verdicts. Restore torchvision's
# defaults with TIE_INPUT_MIN_SIZE=800 / TIE_INPUT_MAX_SIZE=1333 only after
# measuring the resulting latency and memory.
TIE_INPUT_MIN_SIZE=32
TIE_INPUT_MAX_SIZE=1024
# TIE_MODEL_PATH=models/tie_detector_v1.pt
# TIE_MODEL_POLICY_PATH=models/tie_detector_v1.policy.json
# TIE_MODEL_DEVICE=cpu
# TIE_MODEL_RAW_THRESHOLD=0.05
# TIE_MODEL_VERSION=tie-detector-dev

# Upper-body visibility gate
# TIE_MIN_FACE_HEIGHT=80
# TIE_MIN_VISIBLE_BELOW_FACE_RATIO=0.35
# Minimum below-face band that still includes the upper knot. A crop that
# shows the knot but not the blade is accepted at this ratio.
# TIE_MIN_COLLAR_VISIBLE_RATIO=0.08

# Official-tie rule. Default type_only: accept a traditional necktie and
# reject bow ties / scarves. Appearance matching stays off until the
# university publishes the official design (colour/pattern ranges).
# OFFICIAL_TIE_POLICY_PATH=models/official_tie.policy.example.json

# ---------------------------------------------------------------------------
# Readiness gating (/ready)
# ---------------------------------------------------------------------------
# 1 = /ready returns 503 until the tie detector actually loads.
REQUIRE_TIE_MODEL_READY=1
# 1 = also require the rembg session (only needed if /edit-photo is used).
REQUIRE_REMBG_READY=0
# 1 = /ready returns 503 while MediaPipe landmarks are unusable. Without
# landmarks the head_pose and eyes_open criteria cannot pass, so such a worker
# rejects valid photographs and must be taken out of rotation.
REQUIRE_LANDMARKS_READY=1

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=12
MAX_IMAGE_PIXELS=40000000
MAX_JSON_FIELD_CHARS=20000
MAX_EDIT_DIMENSION=6000
MAX_EDIT_PIXELS=40000000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
GUNICORN_BIND=127.0.0.1:5001
# Comma-separated Host values accepted by Flask. Keep this aligned with the
# internal proxy/portal address; do not use '*' in production.
TRUSTED_HOSTS=127.0.0.1,localhost
GUNICORN_WORKERS=2
# Must stay ABOVE the PHP caller's budget (VERIFY_TIMEOUT_SECONDS +
# EDIT_TIMEOUT_SECONDS in php-app/api/verify.php, currently 60 + 30) so
# Gunicorn never kills a worker that PHP is still waiting on.
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO

# Threads each worker may use for Torch/OpenCV inference. Defaults to
# cores / GUNICORN_WORKERS. Leaving every worker at the library default makes
# N workers oversubscribe the CPU N-fold and all of them slower under load.
# TORCH_NUM_THREADS=2

# Only needed if a browser calls this service directly. Server-to-server
# calls from PHP do not need CORS; leave empty to disable it entirely.
# PORTAL_CORS_ORIGINS=https://portal.university.edu

# ---------------------------------------------------------------------------
# Optional training-data capture (disabled by default)
# ---------------------------------------------------------------------------
# This captures originals plus inference metadata for later human labelling.
# It does NOT train or alter the live model. Enable only after privacy review,
# consent, retention, access-control, and disk-capacity controls are approved.
TRAINING_CAPTURE_ENABLED=0
TRAINING_CAPTURE_DIR=/var/lib/passport-verification/training-data/inbox
